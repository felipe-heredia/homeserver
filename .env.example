# ==== Restic / Backblaze B2 ==== #

RESTIC_REPOSITORY=""
RESTIC_PASSWORD=""
B2_ACCOUNT_ID=""
B2_ACCOUNT_KEY=""

# ==== Paths ==== #

BACKUP_ROOT="/srv/backups"
DOCKER_ROOT="/srv/docker"
IMMICH_LIBRARY="/srv/docker/photos/config/immich-library"

# ==== Container names === #
IMMICH_DB_CONTAINER="immich_postgres"

# ==== Retention ==== #
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=6

# ==== Logging ==== #
LOG_DIR="${BACKUP_ROOT}/logs"
LOG_RETENTION_DAYS=30
